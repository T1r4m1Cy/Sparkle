{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "powershell",
      "args": [
          "-Command",
          "g++ -std=c++20 $(Get-ChildItem -Path '${workspaceFolder}/src' -Recurse -Filter '*.cpp' | ForEach-Object { $_.FullName }) -IC:/Programming/Vulkan/Include -LC:/Programming/Vulkan/Lib -lvulkan-1 -lSDL2 -o '${workspaceFolder}/build/engine.exe'"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}